# Copy this file to .env for local development. Do not commit real secrets.
SECRET_KEY=change-me-to-a-long-random-value
DATABASE_URL=postgresql+psycopg2://localhost:5432/glenville_forum
FLASK_DEBUG=1
SESSION_COOKIE_SECURE=0
ADMIN_EMAILS=
MAX_CONTENT_LENGTH=8388608
MAX_FORM_MEMORY_SIZE=2097152

# Production examples:
# FLASK_DEBUG=0
# SESSION_COOKIE_SECURE=1
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME
